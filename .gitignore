# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
.idea/
.DS_Store
*.ipr
*.iml
*.iws
*.apk
*.ap_

